import mensajeros.*
import mensajeria.*


test "facturacion" {
    empresa.enviar(paquete)
    empresa.enviar(paquetito)
    empresa.enviar(paqueton)
    assert.equals(50, empresa.facturacion())
}

test "facturacion con paqueton no pagado" {
    empresa.enviar(paqueton)
    assert.equals(0, empresa.facturacion())
}